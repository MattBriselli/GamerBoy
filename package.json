{
  "name": "gamerboy-studio",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm --workspace=@gamerboy/solitaire run start",
    "ios": "npm --workspace=@gamerboy/solitaire run ios",
    "android": "npm --workspace=@gamerboy/solitaire run android",
    "web": "npm --workspace=@gamerboy/solitaire run web",
    "lint": "eslint apps packages",
    "typecheck": "tsc --noEmit",
    "test": "npm --workspace=@gamerboy/solitaire run test"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  }
}
